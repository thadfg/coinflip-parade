{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mcp": {
    "NodePath": "C:\\Program Files\\Microsoft Visual Studio\\2022\\Enterprise\\MSBuild\\Microsoft\\VisualStudio\\NodeJs",
    "McpCommand": "npx",
    "McpArgs": [ "-y", "@playwright/mcp@latest" ],
    "WindowsNodePath": "C:\\Program Files\\Microsoft Visual Studio\\2022\\Enterprise\\MSBuild\\Microsoft\\VisualStudio\\NodeJs",
    "LinuxNodePath": "",
    "WindowsNpxCommand": "npx.cmd",
    "LinuxNpxCommand": "npx",
    "WindowsNodeExecutable": "node.exe",
    "LinuxNodeExecutable": "node"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317",
    "ServiceName": "valuation-service"
  },
  "Scalar": {
    "ServerUrl": "https://localhost:8443",
    "Title": "Valuation Service API",
    "Theme": "Saturn",
    "Layout": "Modern"
  },
  "Valuations": {
    "CutoffDays": 30,
    "BatchSize": 10,
    "DelayMinutes": 1
  },
  "Parser": {
    "IgnoredValues": [ 2.0, 4.0 ],
    "MaxValidValue": 1000000.0,
    "IgnoredLogMarkers": [ "Executed DbCommand", "Parameters=[" ]
  }
}
