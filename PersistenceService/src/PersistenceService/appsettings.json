{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kafka": {
    "BootstrapServers": "kafka:9092",
    "GroupId": "comic-consumer-group",
    "Topic": "comic-imported",
    "LogTopic": "service-logs",
    "AutoOffsetReset": "Earliest",
    "BatchSize": 10,
    "FlushIntervalSeconds": 20,
    "ConsumeTimeoutMs": 10,
    "ConsumeInitializeDelay": 1000,
    "DatabaseReadyCheckDelaySeconds": 2,
    "SessionTimeoutMs": 30000,
    "SocketTimeoutMs": 60000,
    "MaxPollIntervalMs": 300000,
    "AutoCommitIntervalMs": 5000,
    "LagUpdateIntervalSeconds": 5,
    "LogBatchSize": 50,
    "LogFlushIntervalSeconds": 2
  },
  "Repository": {
    "MaxRetries": 3,
    "DelayMilliseconds": 500,
    "DbMaxRetryCount": 5,
    "DbMaxRetryDelaySeconds": 30
  },
  "AllowedHosts": "*"
}
