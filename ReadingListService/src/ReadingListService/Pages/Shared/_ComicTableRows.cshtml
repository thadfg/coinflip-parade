@using ReadingListService.Dtos
@model List<ComicSearchResultDto>
@{
    var currentPage = Context.Request.Query.ContainsKey("page") ? int.Parse(Context.Request.Query["page"]!) : 1;
    var searchTerm = Context.Request.Query["term"].ToString();
    var sortBy = Context.Request.Query["sortBy"].ToString();
    var sortDescending = Context.Request.Query["desc"].ToString();
    var nextPage = currentPage + 1;
}

@if (Model.Any())
{
    @for (int i = 0; i < Model.Count; i++)
    {
        var comic = Model[i];
        var isLast = i == Model.Count - 1;
        
        if (isLast)
        {
            <tr hx-get="@Html.Raw($"?handler=Search&term={searchTerm}&page={nextPage}&sortBy={sortBy}&desc={sortDescending}")" 
                hx-trigger="revealed" 
                hx-swap="afterend" 
                hx-target="this"
                hx-indicator="#infinite-scroll-indicator">
                <td>@comic.FullTitle</td>
                <td>@comic.SeriesName</td>
                <td>#@comic.IssueNumber</td>
                <td>@comic.PublisherName</td>
                <td>@(comic.ReleaseDate?.ToShortDateString() ?? "N/A")</td>
                <td>
                    <span class="badge @(comic.IsRead ? "bg-success" : "bg-secondary")">
                        @(comic.IsRead ? "Read" : "Unread")
                    </span>
                </td>
            </tr>
        }
        else
        {
            <tr>
                <td>@comic.FullTitle</td>
                <td>@comic.SeriesName</td>
                <td>#@comic.IssueNumber</td>
                <td>@comic.PublisherName</td>
                <td>@(comic.ReleaseDate?.ToShortDateString() ?? "N/A")</td>
                <td>
                    <span class="badge @(comic.IsRead ? "bg-success" : "bg-secondary")">
                        @(comic.IsRead ? "Read" : "Unread")
                    </span>
                </td>
            </tr>
        }
    }
}
else if (currentPage == 1)
{
    <tr>
        <td colspan="6" class="text-center text-muted">No comics found in your collection.</td>
    </tr>
}
