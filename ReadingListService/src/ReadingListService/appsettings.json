{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Service": {
    "PathBase": "/readinglist",
    "HealthCheckPath": "/api/reading-list/health"
  },
  "Search": {
    "DefaultPageSize": 50,
    "ExclusionPattern": "%Annual%"
  }
}
